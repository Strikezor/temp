1. The Utility Class: SftpUtil.java
This class handles the core JSch library connections. It connects to the NPCI production environment over the internet using the DNS nachh2h.npci.org.in and port 9293.
package com.bank.h2h.util;

import com.jcraft.jsch.Channel;
import com.jcraft.jsch.ChannelSftp;
import com.jcraft.jsch.JSch;
import com.jcraft.jsch.JSchException;
import com.jcraft.jsch.Session;
import com.jcraft.jsch.SftpException;

public class SftpUtil {

    private Session session = null;
    private ChannelSftp channelSftp = null;

    public void connect(String username, String privateKeyPath) throws JSchException {
        JSch jsch = new JSch();
        jsch.addIdentity(privateKeyPath);

        // NACH Production Host to Host Connection (Internet)[span_1](start_span)[span_1](end_span)
        String host = "nachh2h.npci.org.in"; 
        int port = 9293; 

        session = jsch.getSession(username, host, port);
        
        java.util.Properties config = new java.util.Properties();
        config.put("StrictHostKeyChecking", "no"); 
        session.setConfig(config);

        session.connect();
        Channel channel = session.openChannel("sftp");
        channel.connect();
        channelSftp = (ChannelSftp) channel;
    }

    public void uploadFile(String localFilePath, String remoteFileName) throws SftpException {
        if (channelSftp == null || !channelSftp.isConnected()) {
            throw new SftpException(ChannelSftp.SSH_FX_FAILURE, "SFTP Channel is not connected.");
        }
        
        // Files to be uploaded from the bank must be in the root directory ("/")[span_2](start_span)[span_2](end_span)
        String destinationPath = "/" + remoteFileName;
        channelSftp.put(localFilePath, destinationPath);
    }

    public void disconnect() {
        if (channelSftp != null && channelSftp.isConnected()) {
            channelSftp.disconnect();
        }
        if (session != null && session.isConnected()) {
            session.disconnect();
        }
    }
}

2. The Main Class: H2HMainProcessor.java
This class acts as the business logic coordinator. It takes the file details provided by the Launcher, initializes the utility, and handles the automated file transfer execution using Secure File Transfer Protocol (SFTP).
package com.bank.h2h.core;

import com.bank.h2h.util.SftpUtil;

public class H2HMainProcessor {

    private final String privateKeyPath;
    private final String username;

    public H2HMainProcessor(String privateKeyPath, String username) {
        this.privateKeyPath = privateKeyPath;
        this.username = username;
    }

    public boolean sendFileToNACH(String localFilePath, String remoteFileName) {
        SftpUtil sftpUtil = new SftpUtil();
        boolean isSuccess = false;

        try {
            System.out.println("Initiating SFTP connection to NACH for file: " + remoteFileName);
            sftpUtil.connect(username, privateKeyPath);
            
            System.out.println("Uploading file...");
            sftpUtil.uploadFile(localFilePath, remoteFileName);
            
            System.out.println("File successfully uploaded. NACH server will immediately pick up and process the file[span_4](start_span)[span_4](end_span).");
            isSuccess = true;

        } catch (Exception e) {
            System.err.println("Failed to process file transfer: " + e.getMessage());
        } finally {
            sftpUtil.disconnect();
            System.out.println("SFTP connection closed.");
        }

        return isSuccess;
    }
}

3. The Launcher Class: H2HLauncher.java
This is the entry point. It represents the environment that picks up local files (e.g., INP and RTN files) and triggers the main class to process them.
package com.bank.h2h.launcher;

import com.bank.h2h.core.H2HMainProcessor;
import java.io.File;

public class H2HLauncher {

    public static void main(String[] args) {
        // Configuration parameters
        String privateKey = "/app/security/bank_private_key.pem";
        String nachUserId = "YOUR_BANK_H2H_ID";
        String localDirectory = "/app/data/outbound/";

        H2HMainProcessor processor = new H2HMainProcessor(privateKey, nachUserId);

        // Simulated record picking: Read all files in the designated local directory
        File dir = new File(localDirectory);
        File[] filesToProcess = dir.listFiles();

        if (filesToProcess != null && filesToProcess.length > 0) {
            System.out.println("Found " + filesToProcess.length + " files to process.");
            
            for (File file : filesToProcess) {
                if (file.isFile()) {
                    String localFilePath = file.getAbsolutePath();
                    String remoteFileName = file.getName();
                    
                    System.out.println("--- Picking record: " + remoteFileName + " ---");
                    processor.sendFileToNACH(localFilePath, remoteFileName);
                }
            }
        } else {
            System.out.println("No records found in " + localDirectory + " to process.");
        }
    }
}

